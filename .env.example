# LandHub Sri Lanka — environment configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Security — CHANGE THIS IN PRODUCTION
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# Database Configuration
# Default local demo runtime uses SQLite.
# For production Microsoft SQL Server deployment, set DB_TYPE=mssql and configure below:
DB_TYPE=sqlite
DB_FILE=./landhub.sqlite

# Microsoft SQL Server (SSMS / Production)
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=landhub_lk
MSSQL_USER=landhub
MSSQL_PASSWORD=Landhub@2026
MSSQL_TRUST_SERVER_CERTIFICATE=true
MSSQL_ENCRYPT=false

# Optional: Google Maps JavaScript API key (embed view works without one)
# GOOGLE_MAPS_API_KEY=
